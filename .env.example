# ─────────────────────────────────────────────────────────────────────────────
# AMSAT Discord Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Required OAuth2 scopes: bot, applications.commands
# Required bot permissions: Manage Roles
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_discord_server_id

# The Discord role ID whose holders can run /admin commands
DISCORD_ADMIN_ROLE_ID=your_admin_role_id

# ── WildApricot ───────────────────────────────────────────────────────────────
# API key: WildApricot admin panel → Settings → Authorized applications
# Account ID is derived automatically from the OAuth token — no need to set it.
WILDAPRICOT_API_KEY=your_wildapricot_api_key

# ── AMSAT Status API ───────────────────────────────────────────────────────────
# Base URL for AMSAT status API used by /tle autocomplete + list catalog
AMSAT_STATUS_API_BASE_URL=https://amsat.org/status/api

# ── Amazon SES ────────────────────────────────────────────────────────────────
# IAM user needs: ses:SendEmail on your verified sending identity
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
SES_FROM_ADDRESS=bot@yourdomain.org
SES_FROM_NAME=AMSAT Discord Bot

# ── Role Mapping ──────────────────────────────────────────────────────────────
# JSON object: WildApricot membership level name → Discord role ID
#
# IMPORTANT: Keys are case-sensitive and must exactly match the membership level
# strings returned by WildApricot — verify your actual level names under:
#   WildApricot admin → Members → Levels
# or by running /admin lookup on a known member and checking the returned level.
# A mismatch will cause /verify confirm to fail with a configuration error.
#
# Multiple WildApricot levels can map to the same Discord role ID.
# Right-click a role in Discord Server Settings → Roles to copy its ID.
#
# Example (replace with your actual level names and role IDs):
ROLE_MAP={"Basic":"111111111111111111","Student":"111111111111111111","Lifetime":"222222222222222222","Lifetime Provisional":"222222222222222222","Tier3":"333333333333333333","Tier4":"444444444444444444"}

# Optional: role assigned to lapsed/expired members (leave blank to assign nothing)
LAPSED_ROLE_ID=

# ── Verification Settings ─────────────────────────────────────────────────────
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5

# ── Scheduled Sync ────────────────────────────────────────────────────────────
# Cron expression for the nightly role re-sync (default: 2:00 AM UTC daily)
SYNC_CRON=0 2 * * *

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
